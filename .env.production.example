# Copialo a .env.production y completá los valores.
# Cargá con:
#   docker compose --env-file .env.production -f docker-compose.prod.yml up -d --build

# ---- Base de datos (Postgres se crea dentro del compose) ----
POSTGRES_USER=helpdesk
POSTGRES_PASSWORD=cambia-esto-en-produccion
POSTGRES_DB=helpdesk

# ---- Aplicación ----
# Generar AUTH_SECRET con: openssl rand -base64 32
AUTH_SECRET=genera-uno-seguro
AUTH_URL=https://helpdesk.tudominio.com

# Nivel de logs: trace | debug | info | warn | error
LOG_LEVEL=info

# ---- HTTPS (Caddy) ----
APP_DOMAIN=helpdesk.tudominio.com
CADDY_EMAIL=admin@tudominio.com

# ---- Backups ----
# Cantidad de días que se conservan los dumps de DB y los tar de uploads
BACKUP_RETENTION_DAYS=14

# ---- Scheduler / Cron ----
# Secret para el endpoint de tickets recurrentes (default: AGENT_API_TOKEN)
CRON_SECRET=cambia-esto-o-reusa-agent-token

# ---- Email entrante (opcional, Resend inbound) ----
# Token que valida el webhook entrante. Configuralo en Resend como ?token=...
INBOUND_EMAIL_SECRET=

# ---- Fallbacks opcionales ----
# Estas variables sólo se usan si NO configurás la integración desde
# /settings/integrations (que es lo recomendado).
# ANTHROPIC_API_KEY=
# OPENAI_API_KEY=
# RESEND_API_KEY=
# RESEND_FROM="Helpdesk <noreply@tudominio.com>"
