# Config para VPS con Nginx existente. Copiá a .env.vps y completá.
#   docker compose --env-file .env.vps -f docker-compose.vps.yml up -d --build

# ---- Base de datos (Postgres dedicado del helpdesk, en red interna) ----
POSTGRES_USER=helpdesk
POSTGRES_PASSWORD=CAMBIA-ESTO-por-algo-fuerte
POSTGRES_DB=helpdesk

# ---- App ----
# Puerto LOOPBACK libre donde escucha el helpdesk (Nginx proxea acá).
# 3000/3100/4000 ya están ocupados en tu VPS → usamos 3200.
APP_PORT=3200

# Generar con: openssl rand -base64 32
AUTH_SECRET=GENERA-UNO-CON-openssl-rand-base64-32

# URL pública final (con HTTPS, vía Nginx)
AUTH_URL=https://helpdesk.tudominio.com

LOG_LEVEL=info

# ---- Backups (días de retención) ----
BACKUP_RETENTION_DAYS=14

# ---- Scheduler / cron (tickets recurrentes) ----
CRON_SECRET=GENERA-OTRO-secreto

# ---- Setup inicial (crear el primer admin vía /api/setup) ----
# Dejalo vacío/borralo después de crear el admin.
SETUP_TOKEN=GENERA-un-token-temporal

# ---- Email entrante (opcional, Resend inbound) ----
INBOUND_EMAIL_SECRET=

# ---- Fallbacks opcionales (mejor configurar desde /settings/integrations) ----
# ANTHROPIC_API_KEY=
# OPENAI_API_KEY=
# RESEND_API_KEY=
# RESEND_FROM="Helpdesk <noreply@tudominio.com>"
