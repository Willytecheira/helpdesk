# Copiá este archivo a `.env` en docker/evolution/ y completá los valores.

# API key global de Evolution API. Es la que vas a pegar en el panel del helpdesk.
# Generala fuerte:  openssl rand -hex 32
EVOLUTION_API_KEY=cambiame-por-una-clave-larga-y-aleatoria

# URL pública con la que Evolution se identifica (tu subdominio con HTTPS).
EVOLUTION_SERVER_URL=https://evolution.linetechinformatica.com

# Password del Postgres dedicado de Evolution (interno, no se expone).
EVOLUTION_DB_PASSWORD=cambiame-tambien
